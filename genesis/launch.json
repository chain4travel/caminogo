  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run 5 validators network",
      "configurations": ["local-1", "local-2", "local-3", "local-4", "local-5"],
      "preLaunchTask": "build",
      "stopAll": true,
      "env": {
        "GOROOT": "${env:HOME}/.gvm/gos/go1.19",
        "PATH": "${env:HOME}/.gvm/gos/go1.19/bin:${env:PATH}"
      }
    }
  ],
  "configurations": [
    {
      // local-1
      "name": "local-1",
      "args": [
        "--public-ip=127.0.0.1",
        "--http-port=19651",
        "--staking-port=9651",
        "--network-id=kopernikus",
        "--index-enabled=true",
        // "--log-level=debug",
        "--api-admin-enabled-secret=<SECRET>",
        "--bootstrap-ips=",
        "--bootstrap-ids=",
        "--bootstrap-ips=127.0.0.1:9652",
        "--bootstrap-ids=NodeID-D1LbWvUf9iaeEyUbTYYtYq4b7GaYR5tnJ",
        "--staking-tls-key-file=${workspaceFolder}/staking/local/staker1.key",
        "--staking-tls-cert-file=${workspaceFolder}/staking/local/staker1.crt",
        "--genesis=${workspaceFolder}/.vscode/genesis_local_5_validators.json",
        "--db-dir=db",
        "--data-dir=data"
      ],
      "env": {
        "GOROOT": "${env:HOME}/.gvm/gos/go1.19.13",
        "PATH": "${env:HOME}/.gvm/gos/go1.19.13/bin:${env:PATH}"
      },
      "preLaunchTask": "cleanup-local-1",
      "program": "${workspaceFolder}/main/main.go",
      "cwd": "${workspaceFolder}/build/local-1",
      "mode": "auto",
      "type": "go",
      "request": "launch",
      "presentation": {
        "hidden": true
      }
    },
